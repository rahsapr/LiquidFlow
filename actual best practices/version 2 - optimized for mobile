#Section 2 = Overview
This is a sophisticated design specification for "LiquidPrompt," combining high-fidelity UI aesthetics (Glassmorphism) with a Cyber-Futuristic tone.

Based on the JSON data provided, I have synthesized a Single-File HTML/CSS/JS Prototype. This code renders the "Liquid Glass" effect using advanced CSS backdrop-filter, complex shadowing for the "droplet" buttons, and a teleprompter animation engine.

Design Implementation Strategy
To achieve the "Liquid Glass" look described in your visual_effects node without heavy WebGL overhead for the UI itself, I have utilized:

Backdrop Filters: High blur values (40px+) to create the frosted depth.

Specular Lighting: Multiple layers of box-shadow (inset and outset) to simulate the 3D volume and "rim lighting" mentioned in the spec.

Typography: SF Pro-style, heavy weight, uppercase to match the "Teleprompter" utility.


#Section 3 = HTML CODE
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LiquidPrompt | Liquid Glass UI</title>
    <style>
        :root {
            --glass-border: rgba(255, 255, 255, 0.3);
            --glass-highlight: rgba(255, 255, 255, 0.15);
            --glass-shadow: rgba(0, 255, 255, 0.1);
            --neon-cyan: #00f2ff;
            --neon-purple: #bc13fe;
            --text-color: #ffffff;
            --font-stack: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            user-select: none;
        }

        body {
            margin: 0;
            padding: 0;
            background: black;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            font-family: var(--font-stack);
            color: var(--text-color);
            /* Deep gradient background with bokeh feel */
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(20, 0, 50, 0.8) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(0, 40, 60, 0.8) 0%, transparent 50%),
                linear-gradient(135deg, #050510 0%, #1a0b2e 50%, #051020 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
        }

        /* Ambient Orbs for Bokeh Effect behind glass */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.6;
            z-index: 0;
            animation: float 10s infinite alternate ease-in-out;
        }
        .orb-1 { width: 300px; height: 300px; background: var(--neon-purple); top: -50px; left: -50px; }
        .orb-2 { width: 400px; height: 400px; background: var(--neon-cyan); bottom: -100px; right: -100px; animation-delay: -5s; }

        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(20px, 40px) scale(1.1); }
        }

        /* --- UI LAYOUT --- */
        .ui-layer {
            z-index: 10;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100%;
            position: relative;
        }

        /* --- HEADER --- */
        header {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 15px;
        }

        .dynamic-island {
            width: 120px;
            height: 35px;
            background: #000;
            border-radius: 20px;
            margin-bottom: 20px;
            /* Integrated glass feel */
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
        }

        .reading-guide-bar {
            width: 80%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
            box-shadow: 0 0 8px var(--neon-cyan);
            opacity: 0.8;
        }

        /* --- MAIN CONTENT (TELEPROMPTER) --- */
        .teleprompter-container {
            flex-grow: 1;
            width: 90%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
            -webkit-mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
            position: relative;
        }

        .scroll-text {
            font-size: 3rem;
            font-weight: 800;
            text-transform: uppercase;
            line-height: 1.3;
            letter-spacing: -0.02em;
            text-shadow: 0 0 20px rgba(255,255,255,0.3);
            transform: perspective(500px) rotateX(2deg); /* Subtle 3D tilt */
        }

        /* --- CONTROLS CONTAINER (Heavy Liquid Glass) --- */
        .controls-container {
            width: 90%;
            max-width: 400px;
            padding: 20px;
            margin-bottom: 30px;
            border-radius: 40px;
            
            /* The Liquid Glass Effect */
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-top: 1px solid rgba(255, 255, 255, 0.5); /* Rim light */
            box-shadow: 
                0 20px 50px rgba(0,0,0,0.5),
                inset 0 0 30px rgba(255,255,255,0.05),
                0 0 20px var(--glass-shadow); /* Ambient glow */
            
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        /* Secondary Controls (Top Row) */
        .secondary-controls {
            display: flex;
            justify-content: space-between;
            padding: 0 10px;
            font-size: 0.7rem;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .pill-btn {
            padding: 5px 15px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.05);
            color: rgba(255,255,255,0.8);
            cursor: pointer;
        }

        .text-btn-faint {
            padding: 5px 15px;
            color: rgba(255,255,255,0.4);
            cursor: pointer;
        }

        /* Primary Playback (Bottom Row) */
        .primary-controls {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .text-control {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--neon-cyan);
            text-shadow: 0 0 10px rgba(0, 242, 255, 0.5);
            cursor: pointer;
        }

        /* The Liquid Bubble Button */
        .play-bubble {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            
            /* Bubble Physics Look */
            background: radial-gradient(130% 130% at 30% 20%, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.05) 50%, rgba(255,255,255,0) 100%);
            box-shadow: 
                inset -5px -5px 15px rgba(255,255,255,0.1),
                inset 5px 5px 15px rgba(255,255,255,0.5), /* Specular top left */
                0 10px 20px rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.3s ease;
        }

        .play-bubble:active {
            transform: scale(0.95);
        }

        .play-icon {
            width: 0; 
            height: 0; 
            border-top: 10px solid transparent;
            border-bottom: 10px solid transparent;
            border-left: 18px solid white;
            filter: drop-shadow(0 0 5px white);
        }

        /* Speed Dial */
        .speed-dial {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.3);
            background: conic-gradient(from 0deg, rgba(255,255,255,0.1), rgba(255,255,255,0.4) 70%, transparent 70%);
            position: relative;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
        }
        
        .speed-label {
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.5rem;
            opacity: 0.6;
        }

    </style>
</head>
<body>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="ui-layer">
        <header>
            <div class="dynamic-island"></div>
            <div class="reading-guide-bar"></div>
        </header>

        <div class="teleprompter-container">
            <div class="scroll-text" id="teleprompterText">
                Welcome to the future of teleprompting.<br><br>
                This is a demonstration of the<br>
                <span style="color: var(--neon-cyan)">Liquid Glass UI.</span><br><br>
                Prepare for presentation<br>
                with confidence.
            </div>
        </div>

        <div class="controls-container">
            <div class="secondary-controls">
                <div class="pill-btn">SETTINGS</div>
                <div class="text-btn-faint">MIRROR</div>
            </div>

            <div class="primary-controls">
                <div class="text-control">RW</div>
                
                <div class="play-bubble" id="playBtn">
                    <div class="play-icon"></div>
                </div>

                <div class="text-control">FF</div>

                <div class="speed-dial">
                    <div class="speed-label">SPEED</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Simple Interaction Logic
        const playBtn = document.getElementById('playBtn');
        const text = document.getElementById('teleprompterText');
        let isPlaying = false;
        let animationId;

        playBtn.addEventListener('click', () => {
            isPlaying = !isPlaying;
            
            // Visual toggle of button (simple opacity shift for demo)
            playBtn.style.background = isPlaying 
                ? 'radial-gradient(130% 130% at 30% 20%, rgba(0, 242, 255, 0.4) 0%, rgba(0, 242, 255, 0.05) 50%, rgba(255,255,255,0) 100%)'
                : 'radial-gradient(130% 130% at 30% 20%, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.05) 50%, rgba(255,255,255,0) 100%)';

            if (isPlaying) {
                scrollText();
            } else {
                cancelAnimationFrame(animationId);
            }
        });

        let scrollPos = 0;
        function scrollText() {
            scrollPos -= 0.5; // Speed
            text.style.transform = `perspective(500px) rotateX(2deg) translateY(${scrollPos}px)`;
            
            // Loop for demo purposes
            if (scrollPos < -200) scrollPos = 200;
            
            animationId = requestAnimationFrame(scrollText);
        }
    </script>
</body>
</html>