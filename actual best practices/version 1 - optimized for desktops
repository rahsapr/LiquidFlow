<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liquid Glass Teleprompter</title>
    <style>
        :root {
            --glass-border: rgba(255, 255, 255, 0.4);
            --glass-surface: rgba(255, 255, 255, 0.1);
            --glass-highlight: rgba(255, 255, 255, 0.2);
            --glass-shadow: rgba(0, 0, 0, 0.2);
            --neon-purple: #bd00ff;
            --deep-blue: #2a00ff;
            --text-color: #FFFFFF;
            --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            user-select: none; /* UI feel */
        }

        body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #050505;
            font-family: var(--font-stack);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* --- Environment Background --- */
        .environment {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background: radial-gradient(circle at 20% 30%, var(--deep-blue), transparent 60%),
                        radial-gradient(circle at 80% 70%, var(--neon-purple), transparent 60%),
                        linear-gradient(135deg, #0a0a1a 0%, #1a0b2e 100%);
            filter: blur(40px); /* Deep bokeh effect */
        }

        /* Lighting effects */
        .environment::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 60%);
            animation: lightShift 20s infinite alternate;
        }

        @keyframes lightShift {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-50px, -20px); }
        }

        /* --- Main Window Frame --- */
        .glass-window {
            position: relative;
            z-index: 10;
            width: 90vw;
            height: 85vh;
            max-width: 1000px;
            background: var(--glass-surface);
            backdrop-filter: blur(35px) saturate(180%);
            -webkit-backdrop-filter: blur(35px) saturate(180%);
            border-radius: 32px;
            border: 1px solid var(--glass-border);
            box-shadow: 
                0 20px 50px rgba(0,0,0,0.3),
                inset 0 0 0 1px rgba(255,255,255,0.1),
                inset 0 0 20px rgba(255,255,255,0.1); /* Inner glow */
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: transform 0.1s ease;
        }

        /* --- Header --- */
        .header {
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .traffic-lights {
            display: flex;
            gap: 8px;
        }
        .light { width: 12px; height: 12px; border-radius: 50%; }
        .red { background: #ff5f56; border: 1px solid #e0443e; }
        .yellow { background: #ffbd2e; border: 1px solid #dea123; }
        .green { background: #27c93f; border: 1px solid #1aab29; }

        .address-bar {
            background: rgba(0, 0, 0, 0.2);
            padding: 6px 16px;
            border-radius: 20px;
            color: rgba(255,255,255,0.6);
            font-size: 13px;
            font-weight: 500;
            box-shadow: inset 0 1px 4px rgba(0,0,0,0.1);
            border: 1px solid rgba(255,255,255,0.05);
        }

        .actions {
            display: flex;
            gap: 16px;
        }
        .icon {
            width: 20px;
            height: 20px;
            fill: rgba(255,255,255,0.8);
            cursor: pointer;
            transition: fill 0.2s;
        }
        .icon:hover { fill: white; }

        /* --- Teleprompter Display --- */
        .display-area {
            flex: 1;
            position: relative;
            overflow: hidden;
            display: flex;
            justify-content: center;
            /* Gradient mask to fade text at top and bottom */
            mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
        }

        .scroll-container {
            width: 80%;
            position: absolute;
            top: 50%; /* Start in middle */
            transform: translateY(0);
            will-change: transform;
        }

        .prompter-text {
            color: white;
            font-size: 4rem;
            font-weight: 800;
            text-transform: uppercase;
            line-height: 1.4;
            text-align: left;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            font-feature-settings: "tnum";
            font-variant-numeric: tabular-nums;
        }

        /* --- Floating Controls (Bottom Center) --- */
        .controls-container {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(200, 200, 200, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 12px 24px;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.4);
            z-index: 20;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        
        .controls-container:hover {
            background: rgba(200, 200, 200, 0.25);
            transform: translateX(-50%) scale(1.02);
        }

        .btn {
            background: none;
            border: none;
            cursor: pointer;
            color: white;
            font-weight: 600;
            font-size: 14px;
            opacity: 0.8;
            transition: all 0.2s;
        }
        .btn:hover { opacity: 1; transform: scale(1.1); }
        
        .play-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.9);
            color: black;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px rgba(255,255,255,0.3);
        }
        .play-btn svg { width: 20px; height: 20px; fill: black; margin-left: 2px; }
        .play-btn.paused svg { margin-left: 0; }

        /* Rotary Dial */
        .knob-container {
            position: relative;
            width: 40px;
            height: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: ns-resize;
        }
        .knob-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,0.2);
            border-top: 3px solid rgba(255,255,255,0.9);
            transform: rotate(0deg);
            transition: transform 0.1s linear;
        }
        .knob-label {
            font-size: 8px;
            font-weight: bold;
            color: rgba(255,255,255,0.6);
        }

        /* --- Utility Menu (Bottom Right) --- */
        .utility-menu {
            position: absolute;
            bottom: 40px;
            right: 40px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 20;
        }

        .utility-pill {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 20px;
            color: white;
            font-size: 12px;
            font-weight: 600;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.15);
            cursor: pointer;
            transition: background 0.2s;
        }
        .utility-pill:hover { background: rgba(255, 255, 255, 0.2); }

        /* Guide Line */
        .guide-line {
            position: absolute;
            top: 25%;
            left: 5%;
            width: 90%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
            z-index: 5;
            pointer-events: none;
        }
        
        .speed-indicator {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.5);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
        }
        .knob-container:hover .speed-indicator, .knob-container:active .speed-indicator {
            opacity: 1;
        }

    </style>
</head>
<body>

    <div class="environment"></div>

    <div class="glass-window">
        
        <div class="header">
            <div class="traffic-lights">
                <div class="light red"></div>
                <div class="light yellow"></div>
                <div class="light green"></div>
            </div>
            
            <div class="address-bar">teleprompter.app/desktop</div>
            
            <div class="actions">
                <svg class="icon" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/></svg>
                <svg class="icon" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                <svg class="icon" viewBox="0 0 24 24"><path d="M3 17h18v-2H3v2zm0-7v2h18v-2H3zm0-9v2h18V1H3z"/></svg>
            </div>
        </div>

        <div class="display-area">
            <div class="guide-line"></div>
            <div class="scroll-container" id="scrollContainer">
                <div class="prompter-text" id="textBlock">
                    Welcome to the future of teleprompting.<br><br>
                    This is a demonstration of the Liquid Glass UI designed for high-end spatial computing environments.<br><br>
                    Notice the heavy gaussian blur and the specular highlights on the edges of the window frame.<br><br>
                    The typography is set to San Francisco Bold Uppercase to maximize readability against complex backgrounds.<br><br>
                    Adjust the speed using the rotary dial below, or use the playback controls to pause the stream.<br><br>
                    (Scroll Loop) <br><br>
                    The quick brown fox jumps over the lazy dog. The UI elements appear to float above the content.<br><br>
                    End of script.
                </div>
            </div>
        </div>

    </div>

    <div class="controls-container">
        <button class="btn" onclick="rewind()">RW</button>
        
        <button class="btn play-btn" id="playPauseBtn" onclick="togglePlay()">
            <svg id="playIcon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <svg id="pauseIcon" viewBox="0 0 24 24" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>
        
        <button class="btn" onclick="fastForward()">FF</button>
        
        <div class="knob-container" id="speedKnob">
            <div class="speed-indicator" id="speedValue">1x</div>
            <div class="knob-ring" id="knobRing"></div>
            <span class="knob-label">SPD</span>
        </div>
    </div>

    <div class="utility-menu">
        <div class="utility-pill">SETTINGS</div>
        <div class="utility-pill">SCRIPT EDITOR</div>
        <div class="utility-pill">MIRRORING</div>
    </div>

    <script>
        // State
        let isPlaying = false;
        let scrollSpeed = 1.0; // Pixels per frame
        let currentPos = 0;
        let animationId = null;

        // Elements
        const container = document.getElementById('scrollContainer');
        const textBlock = document.getElementById('textBlock');
        const playBtn = document.getElementById('playPauseBtn');
        const playIcon = document.getElementById('playIcon');
        const pauseIcon = document.getElementById('pauseIcon');
        const knobRing = document.getElementById('knobRing');
        const knob = document.getElementById('speedKnob');
        const speedValDisp = document.getElementById('speedValue');

        // Center text initially
        const resetPosition = () => {
            currentPos = 200; // Start slightly down
            container.style.transform = `translateY(${currentPos}px)`;
        };
        resetPosition();

        // Animation Loop
        function animate() {
            if (isPlaying) {
                currentPos -= scrollSpeed;
                
                // Infinite Scroll Check
                const contentHeight = textBlock.offsetHeight;
                if (Math.abs(currentPos) > contentHeight) {
                    currentPos = window.innerHeight; // Reset to bottom
                }
                
                container.style.transform = `translateY(${currentPos}px)`;
            }
            animationId = requestAnimationFrame(animate);
        }
        
        // Start Loop
        animate();

        // Controls
        function togglePlay() {
            isPlaying = !isPlaying;
            if (isPlaying) {
                playIcon.style.display = 'none';
                pauseIcon.style.display = 'block';
                playBtn.classList.add('paused');
            } else {
                playIcon.style.display = 'block';
                pauseIcon.style.display = 'none';
                playBtn.classList.remove('paused');
            }
        }

        function rewind() {
            currentPos += 200;
            container.style.transform = `translateY(${currentPos}px)`;
        }

        function fastForward() {
            currentPos -= 200;
            container.style.transform = `translateY(${currentPos}px)`;
        }

        // Speed Knob Logic (Click and Drag Y-axis)
        let isDragging = false;
        let startY = 0;
        let startSpeed = 0;

        knob.addEventListener('mousedown', (e) => {
            isDragging = true;
            startY = e.clientY;
            startSpeed = scrollSpeed;
            document.body.style.cursor = 'ns-resize';
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
            document.body.style.cursor = 'default';
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            
            const deltaY = startY - e.clientY; // Up is positive
            const sensitivity = 0.05;
            
            let newSpeed = startSpeed + (deltaY * sensitivity);
            
            // Clamp speed
            if (newSpeed < 0) newSpeed = 0;
            if (newSpeed > 5) newSpeed = 5;
            
            scrollSpeed = newSpeed;
            
            // Visual Updates
            updateKnobVisuals();
        });

        function updateKnobVisuals() {
            // Rotate ring based on speed (0 to 5 mapped to -135deg to 135deg)
            const rotation = (scrollSpeed / 5) * 270 - 135;
            knobRing.style.transform = `rotate(${rotation}deg)`;
            speedValDisp.textContent = scrollSpeed.toFixed(1) + 'x';
        }
        
        // Initial knob state
        updateKnobVisuals();

        // Add keyboard support
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space') togglePlay();
            if (e.code === 'ArrowUp') { scrollSpeed += 0.5; updateKnobVisuals(); }
            if (e.code === 'ArrowDown') { scrollSpeed = Math.max(0, scrollSpeed - 0.5); updateKnobVisuals(); }
        });

    </script>
</body>
</html>